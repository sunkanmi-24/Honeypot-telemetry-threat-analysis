# Local development environment template — copy to ".env" and edit.
# NEVER commit the real .env, and NEVER put secrets in this template file.

# --- Telemetry storage -------------------------------------------------
# Leave unset to use local SQLite at <DATA_DIR>/telemetry.db.
# For production use a managed PostgreSQL provider such as Supabase.
# Supabase example (the password is a placeholder — never use a real secret):
# DATABASE_URL=postgresql://postgres:your-password@db.yourprojectref.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Where the local SQLite file lives (single dot = project folder).
DATA_DIR=.

# --- Reverse proxy trust (IMPORTANT, verify before setting) ------------
# Number of verified reverse proxies between the Internet and this app.
# 0 = forwarded-client headers are never trusted (safe default).
# Render typically runs ONE reverse proxy hop -> PROXY_TRUSTED_HOPS=1,
# but VERIFY this in your deployment before relying on source IPs.
PROXY_TRUSTED_HOPS=0

# --- Behaviour ----------------------------------------------------------
# Mark loopback/private-IP requests as synthetic (local/test traffic).
MARK_LOCAL_SYNTHETIC=1

# --- Optional geographic enrichment -------------------------------------
# Path to a licensed GeoLite2 Country/City .mmdb (requires `geoip2`).
# Leaving this empty keeps country values "unknown"; never guess a country.
GEOIP_DB_PATH=

# --- Development only ---------------------------------------------------
# Enable the Flask debugger for local development. Never enable publicly.
# Run locally:  python app.py --debug
APP_DEBUG=0
